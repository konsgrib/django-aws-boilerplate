# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=*
DEBUG=false

# Django Superuser (created automatically on first start)
# On EC2: credentials loaded from AWS Secrets Manager
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password

# Database (AWS RDS or EC2 PostgreSQL)
DB_NAME=myapp
DB_USERNAME=myapp
DB_PASSWORD=your-db-password-here
DB_HOST=postgres
DB_PORT=5432

# AWS Settings
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-1
S3_BUCKET=mycompany-dev-media
STACK_NAME=mycompany-dev

# Note: On EC2, this file is auto-generated by UserData script
# from AWS Secrets Manager and SSM Parameter Store.
# Do not manually edit .env on EC2.
